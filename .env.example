# MongoDB Connection String (Atlas URI or local mongodb://127.0.0.1:27017/smart_roster)
# If left unset or unreachable, the system automatically falls back to an embedded in-memory database
MONGODB_URI=mongodb://127.0.0.1:27017/smart_roster

# JWT Authentication Secret (Use a secure, random string in production)
JWT_SECRET=replace_with_your_strong_random_jwt_secret_here

# Server Port
PORT=5000

# Client Application URL (for CORS origins)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
